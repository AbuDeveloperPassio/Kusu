{
  "name": "mean-notes",
  "version": "1.0.0",
  "private": true,
  "description": "MEAN stack notes app (MongoDB, Express, Angular, Node) with JWT auth",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "build": "npm run client:install && npm run client:build"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0"
  }
}
